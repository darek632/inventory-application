<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title><%= title%></title>
</head>
<body>
    <%- include('../partials/header') %>

    <main class="theme-categories">
        <div class="page-title">
            <h1><%= title %></h1>
            <p>Browse parts by category.</p>
        </div>

        <% if (categories.length === 0) { %>
            <p>No categories yet.</p>
        <% } else { %>
            <ul class="grid">
                <% categories.forEach((category) => { %>
                    <li class="card">
                        <span class="label">Category</span>
                        <h3><a href="/categories/<%= category.id %>"><%= category.name %></a></h3>
                        <% if (category.description) { %>
                            <p class="meta"><%= category.description %></p>
                        <% } %>
                    </li>
                <% }); %>
            </ul>
        <% } %>

        <div class="actions">
            <a href="/categories/new" class="btn">Add category</a>
            <a href="/" class="btn btn-secondary">Back to all parts</a>
        </div>
    </main>
</body>
</html>