<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>

    <% if (brands.length === 0) { %>
        <p>No brands yet.</p>
    <% } else { %>
        <ul>
            <% brands.forEach((brand) => { %>
                <li>
                    <a href="/brands/<%= brand.id %>"><%= brand.name %></a>
                </li>
            <% }); %>
        </ul>
    <% } %>
    <a href="/brands/new">Add brand</a>
    <a href="/">Back to all parts</a>
</body>
</html>