<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title><%= title %></title>
</head>
<body>
    <%- include('../partials/header') %>

    <main class="theme-brands">
        <div class="page-title">
            <h1><%= title %></h1>
            <p>Browse parts by brand.</p>
        </div>

        <% if (brands.length === 0) { %>
            <p>No brands yet.</p>
        <% } else { %>
            <ul class="grid">
                <% brands.forEach((brand) => { %>
                    <li class="card">
                        <span class="label">Brand</span>
                        <h3><a href="/brands/<%= brand.id %>"><%= brand.name %></a></h3>
                        <% if (brand.description) { %>
                            <p class="meta"><%= brand.description %></p>
                        <% } %>
                    </li>
                <% }); %>
            </ul>
        <% } %>

        <div class="actions">
            <a href="/brands/new" class="btn">Add brand</a>
            <a href="/" class="btn btn-secondary">Back to all parts</a>
        </div>
    </main>
</body>
</html>