<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link rel="stylesheet" href="/styles.css">
    <title><%= title %></title>
</head>
<body>

     <%- include('../partials/header') %>
     

    <main class="theme-brands">
        <div class="page-title">
            <h1><%= title %></h1>
            <% if (brand.description) { %>
                <p><%= brand.description %></p>
            <% } %>
        </div>
       
        <%- include("../partials/errors") %>

        <form class="stack" action="<%= action %>" method="POST">

            <div class="field">
                <label for="name">Name:</label>
                <input type="text" id="name" name="name" maxlength="100" value="<%= brand.name || '' %>" required>
            </div>
            
            <div class="field">
                <label for="description">Description:</label>
                <textarea id="description" name="description" maxlength="500"><%= brand.description || '' %></textarea>
            </div>
            
            <div class="actions">
                <button type="submit">Save</button>
                <a href="/brands" class="btn btn-secondary">Cancel</a>

            </div>
            
        </form>
    </main>

   
</body>
</html>