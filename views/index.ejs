<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link rel="stylesheet" href="/styles.css">
    <title>Home</title>
</head>
<body>
    <%- include('partials/header') %>

    <main class="main-content">
        <div class="page-title">
            <h2 class="section-title"><%= title %></h2>
            <p class="subtitle">Here is an overview of your entire inventory:</p>
        </div>

        <div class="card-grid">
            <% allParts.forEach((part) => { %>
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <a href="/parts/<%= part.id %>"><%= part.name %></a>
                        </h3>
                    </div>
                    <div class="card-meta">
                        <span class="meta-tag">
                            Brand: <a href="/brands/<%= part.brand_id %>"><%= part.brand %></a>
                        </span>
                        <span class="meta-tag">
                            Category: <a href="/categories/<%= part.category_id %>"><%= part.category %></a>
                        </span>
                    </div>
                </div>
            <% }); %>
        </div>
    </main>
    
</body>
</html>